@model GoogleSheetExtractView
@{
    ViewData["Title"] = "Google Sheets Extract";
}

<h3>Google Sheets Extract</h3>
<!--Add buttons to initiate auth sequence and sign out-->
<div id="btnBlock" class="w-100 container">
    <div class="row">
        <div class="col-12">
            <h4>Google Connection</h4>
        </div>
        <div class="col-12">
            <button class="btn btn-success" id="authorize_button" onclick="handleAuthClick()">Authorize</button>
            <button class="btn btn-warning" id="import_button" onclick="PostCardsImport()">Clear and Override Inventory</button>
            <button class="btn btn-danger" id="signout_button" onclick="handleSignoutClick()">Sign Out</button>
        </div>
        <div id="SheetsForm" class="col-12 container-fluid g-3">
            <div class="row">
                <div class="col-12">
                    <p class="text-white fw-bold">Locate Inventory Range</p>
                </div>
                <div class="col">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Spreadsheet Id</span>
                        <input class="form-control" id="SpreadsheetId" value="@Model.SpreadsheetId" />
                    </div>
                </div>
                <div class="col">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Range</span>
                        <input class="form-control" id="SpreadsheetRange" value="@Model.SheetRange" />
                    </div>
                </div>
            </div>
            <div class="row pt-2 g-2">
                <div class="col-11 text-right">
                </div>
                <div class="col-1 text-right">
                    <button onclick="CheckSpreadsheet()" class="btn btn-success w-100">Check</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="LoadingBar" class="w-100 collapse pt-4 pb-2">
    <div class="w3-border">
        <div id="myBar" class="rounded movingLoadingBar" style="width: 100%; max-height:30px">
            <p class="text-center fw-bold" style="text-shadow:1px 1px 0 #444" id="myBarProgress">100%</p>
        </div>
    </div>
</div>

<div id="SampleExtract" class="collapse container">
    <div class="row">
        <h4 class="col-12">Sample Data Pull</h4>
        <div class="col-12">
            <p class="small">
                Please ensure that the columns of the imported sheet are in the following order:
            </p>
        </div>
        <div class="col-12">
            <table class="table text-white">
                <tbody>
                    <tr>
                        <td>Qty</td>
                        <td>Set</td>
                        <td>Number</td>
                        <td>Mark</td>
                        <td>Language</td>
                        <td>Name</td>
                        <td>Type</td>
                        <td>Rarity</td>
                        <td>Confirmed</td>
                        <td>Location</td>
                        <td>Type 1</td>
                        <td>Type 2</td>
                        <td>Type 3</td>
                        <td>Note</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <pre id="content" style="white-space: pre-wrap;"></pre>
    </div>
</div>

<script src="~/js/GoogleSheets.js" asp-append-version="true"></script>
<script async defer src="https://apis.google.com/js/api.js" onload="gapiLoaded()"></script>
<script async defer src="https://accounts.google.com/gsi/client" onload="gisLoaded()"></script>