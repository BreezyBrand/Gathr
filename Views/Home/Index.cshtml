@{
    ViewData["Title"] = "Home page";
}

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="search-tab" data-bs-toggle="tab" data-bs-target="#searchEntry" type="button" role="tab" aria-controls="searchEntry" aria-selected="true">Database</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventorySearch" type="button" role="tab" aria-controls="inventorySearch" aria-selected="false">Inventory</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="bulk-tab" data-bs-toggle="tab" data-bs-target="#bulkSet" type="button" role="tab" aria-controls="bulkSet" aria-selected="false">Bulk Entry</button>
    </li>
</ul>
<br />
<div class="tab-content" id="pills-tabContent">
    <div id="searchEntry" class="container tab-pane fade show active" role="tabpanel" aria-labelledby="search-tab" tabindex="0">
        <div class="row">
            <h4>Search Card Database</h4>
            <div class="col-4">
                <label class="form-label">Set</label>
                <input onblur="runSearch()" class="form-control" id="searchSet" />
            </div>
            <div class="col-4">
                <label class="form-label">Set Number</label>
                <input onblur="runSearch()" class="form-control" id="searchNum" />
            </div>
            <div class="col-4">
                <label class="form-label">Language</label>
                <input onblur="runSearch()" class="form-control" id="searchLan" />
            </div>
        </div>
    </div>

    <div id="inventorySearch" class="container tab-pane fade" role="tabpanel" aria-labelledby="inventory-tab" tabindex="0">
        <h4>Inventory</h4>
    </div>

    <div id="bulkSet" class="container tab-pane fade" role="tabpanel" aria-labelledby="bulk-tab" tabindex="0">
        <h4>Bulk Entry</h4>
    </div>
    <hr />
</div>

<div id="searchResults" class="container">
    
</div>