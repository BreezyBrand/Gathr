@model ReturnRequest
@inject IConfiguration config;
@{
    ViewData["Title"] = "Home";
    ViewData["MaxResults"] = "";
    bool showArt = config.GetSection("ShowArt").Get<bool>();
}

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="search-tab" data-bs-toggle="tab" data-bs-target="#searchEntry" type="button" role="tab" aria-controls="searchEntry" aria-selected="true" onclick="toggleSearch('database')">Database</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventorySearch" type="button" role="tab" aria-controls="inventorySearch" aria-selected="false" onclick="toggleSearch('inventory')">Inventory</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="location-tab" data-bs-toggle="tab" data-bs-target="#locationSearch" type="button" role="tab" aria-controls="bulkSet" aria-selected="false" onclick="toggleSearch('location')">Location</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="bulk-tab" data-bs-toggle="tab" data-bs-target="#bulkSet" type="button" role="tab" aria-controls="bulkSet" aria-selected="false" onclick="toggleSearch('bulk')">Bulk Entry</button>
    </li>    
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="transactionLog" data-bs-toggle="tab" data-bs-target="#transactionLog" type="button" role="tab" aria-controls="transactionLog" aria-selected="false" onclick="getTransactions()">Transactions</button>
    </li>
</ul>
<br />
<div class="tab-content" id="pills-tabContent">
    <div id="searchEntry" class="container tab-pane fade show active" role="tabpanel" aria-labelledby="search-tab" tabindex="0">
        <h4>Search Card Database</h4>
    </div>
    <div id="inventorySearch" class="container tab-pane fade" role="tabpanel" aria-labelledby="inventory-tab" tabindex="1">
        <h4>Inventory</h4>
    </div>
    <div id="locationSearch" class="container tab-pane fade" role="tabpanel" aria-labelledby="location-tab" tabindex="1">
        <h4>Location</h4>
    </div>
    <div id="bulkSet" class="container tab-pane fade" role="tabpanel" aria-labelledby="bulk-tab" tabindex="2">
        <h4>Bulk Entry</h4>
    </div>
    <div id="transactionLog" class="container tab-pane fade" role="tabpanel" aria-labelledby="transactionLog" tabindex="3">
        <h4>Recent Transactions</h4>
    </div>
    <partial name="Page/_searchSettings" model="@Model"/>
</div>

<div id="searchResults" class="container">
</div>

<div id="drillDown" class="collapse container">
    <div id="drillDownHeader" class="row mb-1">
        <div class="col-12">
            <button class="btn btn-warning" onclick="returnDrilDown()">
                Back to <span id="drillDownBtn">Card Database</span> 
            </button>
        </div>       
    </div>
    <hr />
    <div id="drillDownBody" class="row container">

    </div>
</div>
<div id="LoadingShuffle" class="collapse">
    <div class="flickity-container">
        <div class="hand">
            <div id="shuffleCard1" class="ani-card card-1"><span></span></div>
            <div id="shuffleCard2" class="ani-card card-2"><span></span></div>
            <div id="shuffleCard3" class="ani-card card-3"><span></span></div>
        </div>
    </div>
</div>

<div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <img class="w-100" id="HighlightImage" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>                
            </div>
        </div>
    </div>
</div>