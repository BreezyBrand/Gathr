@{
    ViewData["Title"] = "Home";
}

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="search-tab" data-bs-toggle="tab" data-bs-target="#searchEntry" type="button" role="tab" aria-controls="searchEntry" aria-selected="true" onclick="toggleSearch('database')">Database</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventorySearch" type="button" role="tab" aria-controls="inventorySearch" aria-selected="false" onclick="toggleSearch('inventory')">Inventory</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="bulk-tab" data-bs-toggle="tab" data-bs-target="#bulkSet" type="button" role="tab" aria-controls="bulkSet" aria-selected="false" onclick="toggleSearch('bulk')">Bulk Entry</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="bulk-tab" data-bs-toggle="tab" data-bs-target="#transactionLog" type="button" role="tab" aria-controls="transactionLog" aria-selected="false" onclick="getTransactions()">Transactions</button>
    </li>
</ul>
<br />
<div class="tab-content" id="pills-tabContent">
    <div id="searchEntry" class="container tab-pane fade show active" role="tabpanel" aria-labelledby="search-tab" tabindex="0">
        <h4>Search Card Database</h4>            
    </div>
    <div id="inventorySearch" class="container tab-pane fade" role="tabpanel" aria-labelledby="inventory-tab" tabindex="1">
        <h4>Inventory</h4>
    </div>
    <div id="bulkSet" class="container tab-pane fade" role="tabpanel" aria-labelledby="bulk-tab" tabindex="2">
        <h4>Bulk Entry</h4>
    </div>
    <div id="transactionLog" class="container tab-pane fade" role="tabpanel" aria-labelledby="transactionLog" tabindex="3">
        <h4>Recent Transactions</h4>
    </div>
    <partial name="_searchSettings" />
    <hr />
</div>

<div id="searchResults" class="container">
</div>