@model List<CardView>

<div class="container">
    <div class="row">
        <div class="col-12">
            Cards Missing Art Objects (@Model.Count())
        </div>
        @if (Model.Any())
        {
            @foreach (var card in Model.Take(10))
            {
                <div class="col-6">
                    <p>                        
                        @Html.Raw(card.DisplayNameHTML())
                    </p>
                    <img class="w-50" src="@card.art.png" />
                </div>
            }
        }
    </div>
</div>