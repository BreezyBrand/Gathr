@*Inventory**@
@model List<Gathr.Models.InvOptions>



<div class="container-fluid m-0">
    @if (Model.Any())
    {
        @*Locations*@        
        <p class="fw-bold fst-italic text-center">You own @Model.Count() copies of this card.</p>
        <table class="table small">
            <thead class="text-center">
                <tr>
                    <th class="collapse">Inventory ID</th>
                    <th>Mark</th>
                    <th>Language</th>
                    <th>Location</th>
                    <th>Confirmed</th>
                    <th class="collapse">Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in Model)
                {
                    string mark_id = inv.Id + "_mark";
                    string loc_id = inv.Id + "_loc";
                    string conf_id = inv.Id + "_conf";
                    string row_id = inv.Id + "_row";
                    string lan_id = inv.Id + "_lan";

                    <tr id="@row_id">
                        <td class="collapse">
                            <span id="@inv.Id">@inv.Id</span>
                        </td>
                        <td style="min-width:75px">
                            <partial name="Component/_Mark" model="inv" />
                        </td>
                        <td>
                            @*<input class="form-control" id="@lan_id" value="@inv.Language" />*@
                            <select class="form-control" id="@lan_id" value="@inv.Language">
                                <partial name="Component/_Language" />
                            </select>
                        </td>
                        <td>
                            <input class="form-control collapse" id="@loc_id" value="@inv.Location" onfocus="ShowOptions(this)"/>                            
                        </td>
                        <td class="text-center">
                            @if (inv._confirmed)
                            {
                                <input type="checkbox" class="form-check" id="@conf_id" value="@inv._confirmed" checked />
                            }
                            else
                            {
                                <input type="checkbox" class="form-check" id="@conf_id" value="@inv._confirmed" />
                            }
                        </td>
                        <td class="collapse">
                            @inv.confirmed_date
                        </td>
                        <td class="text-center" style="min-width:100px">
                            <button class="btn btn-success" onclick="UpdateInventory(@inv.Id,'@inv.Card_Id.ToString()','@row_id')">
                                <i class="bi bi-save"></i>
                            </button>
                            <button class="btn btn-danger" onclick="DeleteInventory(@inv.Id,'@inv.Card_Id.ToString()','@row_id')">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    }
    else
    {
        <p class="fw-bold fst-italic text-center">You don't own any of this card!</p>
    }
</div>