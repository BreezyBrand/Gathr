@model ReturnRequest
@inject IConfiguration config;

@{
    bool showArt = config.GetSection("ShowArt").Get<bool>();
    int singleLoad = config.GetSection("MaxSingleLoad").Get<Int32>();
}
@*Locations*@        
@if (Model.Locations.Any())
{    
    <div class="container-fluid mt-3">
        <hr />
        <div class="row g-2">
            <div class="col-8">
                <h4>
                    <span>Location</span>
                </h4>
            </div>
            <div class="col-4 text-end">
                <div class="input-group">
                    <input class="form-control" id="NewLocTypeInput" placeholder="Add New Location Group..." />
                    <div class="input-group-append">
                        <button class="btn btn-success" onclick="CreateNewLocType(this)">+</button>
                    </div>
                </div>
            </div>
            <hr />
            @foreach (var locType in Model.Locations.Where(x => x.Tier.Equals(1)).OrderBy(x => x.Type).Select(x => x.Type).Distinct().ToList())
            {
                <div class="col-8 text-center">
                    <p class="fw-bolder" style="font-size:16pt;">@locType</p>
                </div>
                <div class="col-4 text-end">
                    <div class="input-group">
                        <input class="form-control" id="NewLoc_@locType" placeholder="Add New @locType..." />
                        <div class="input-group-append">
                            <button class="btn btn-success" onclick="CreateNewLocation(this,'@locType','NewLoc_@locType')">+</button>
                        </div>
                    </div>
                </div>
                <hr />
                @foreach (var loc in Model.Locations.Where(x => x.Type.Equals(locType) && x.Tier > 1).OrderBy(x => x.Name))
                {

                    <div class="col-2 small">
                        <div style="font-size:10pt" class="w-100 btn btn-secondary d-flex justify-content-between align-items-center" onclick="ToggleLocationId(this,@loc.Id,'@loc.Name','@loc.Type')">
                            <span class="">@loc.Name</span>
                            <span class="badge bg-primary rounded-pill">@loc.Count</span>
                        </div>
                    </div>

                }
                <hr />
            }
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <h4>No Cards found with Locations</h4>
    </div>
}