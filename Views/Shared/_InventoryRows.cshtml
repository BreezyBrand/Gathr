@model List<CardView>
@inject IConfiguration config;
@{
    string thisID;
    bool showArt = config.GetSection("ShowArt").Get<bool>();
    int singleLoad = config.GetSection("MaxSingleLoad").Get<Int32>();
    bool inInv;
    string invClass;
}
@*Locations*@
@if (Model.Any())
{
    foreach (var card in Model.OrderBy(n => n.set).ThenBy(n => n.SortOrder))
    {
        if (card.in_inventory)
        {
            @foreach (var inv in card.inventory)
            {
                string mark_id = inv.Id + "_mark";
                string loc_id = inv.Id + "_loc";
                string conf_id = inv.Id + "_conf";
                string row_id = inv.Id + "_row";
                string lan_id = inv.Id + "_lan";

                <tr class="invCard InInventory" id="@row_id">
                    <td class="text-center">
                        @if (card.hasArt && showArt)
                        {
                            <img title="@card.name (@card.set.ToUpper():@card.collector_number)" height="50" src="@card.art.png" />
                        }
                        else
                        {
                            <img title="@card.name (@card.set.ToUpper():@card.collector_number)" height="50" src="~/imgback.jpg" />
                        }
                    </td>
                    <td>@Html.Raw(card.DisplayNameHTML())</td>
                    <td>@card.set.ToUpper()</td>
                    <td>@card.collector_number</td>
                    <td class="text-center">
                        <input id="@mark_id" value="@inv.Mark" class="w-25" />
                    </td>
                    <td class="text-center">
                        @* <input id="@lan_id" value="@inv.Language" class="w-25" /> *@
                        <select class="form-control" id="@lan_id" value="@inv.Language">
                            <partial name="_Language" />
                        </select>
                    </td>
                    <td>
                        <input id="@loc_id" value="@inv.Location" class="w-100" />
                    </td>
                    <td class="text-center">
                        <input type="checkbox" id="@conf_id" value="@inv._confirmed" />
                    </td>
                    <td>
                        @foreach (var color in card.colors)
                        {
                            <span class="d-inline-block">@color</span>
                        }
                    </td>
                    <td>@card.type_line</td>
                    <td style="min-width:150px">
                        <button class="btn btn-success" onclick="UpdateInventory(@inv.Id,'@inv.Card_Id.ToString()','@row_id')">
                            <i class="bi bi-floppy"></i>
                        </button>
                        <button class="btn btn-warning" onclick="CloneInventory(@inv.Id,'@inv.Card_Id.ToString()','@row_id')">
                            <i class="bi bi-clipboard-plus"></i>
                        </button>
                        <button class="btn btn-danger" onclick="DeleteInventory(@inv.Id,'@inv.Card_Id.ToString()','@row_id')">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr class="invCard">
                <td class="text-center">
                    @if (card.hasArt && showArt)
                    {
                        <img title="@card.name (@card.set.ToUpper():@card.collector_number)" height="50" src="@card.art.png" class="imgClick" data-bs-toggle="modal" data-bs-target="#imageModal" onclick="imgUpdate(this)" />
                    }
                    else
                    {
                        <img title="@card.name (@card.set.ToUpper():@card.collector_number)" height="50" src="~/imgback.jpg" class="imgClick" data-bs-toggle="modal" data-bs-target="#imageModal" onclick="imgUpdate(this)" />
                    }
                </td>
                <td>@Html.Raw(card.DisplayNameHTML())</td>
                <td>@card.set.ToUpper()</td>
                <td>@card.collector_number</td>
                <td></td>
                <td>@card.DecodeLanguage()</td>
                <td></td>
                <td></td>
                <td>
                    @foreach (var color in card.colors)
                    {
                        <span class="d-inline-block">@color</span>
                    }
                </td>
                <td>@card.type_line</td>
                <td>
                    <button class="btn btn-warning" onclick='AddCard("@card.Id")'>
                        <i class="bi bi-file-plus"></i>
                    </button>
                </td>
            </tr>
        }
    }
    if(Model.Count()<singleLoad){
        <tr id="InvTableendResults" class="EndTable">
            <td colspan="11">
                End of Results
            </td>
        </tr>
    }
}
else
{
    <tr id="InvTableendResults">
        <td colspan="11">
            End of Results
        </td>
    </tr>
}
