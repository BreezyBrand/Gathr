<div id="searchBar" class="container">
    <div class="row">
        <div class="col-6">
            <p class="fw-bold">
                Basic Search
            </p>
        </div>
        <div class="col-6">
            <a href="#">Advanced Settings</a>
        </div>
    </div>
    <div class="row" id="basicSearch">
        <input class="form-control collapse" id="toggleType" value="database" />
        <div class="col-4">
            <label class="form-label">Set</label>
            <input onblur="runSearch()" class="form-control" id="searchSet" />
        </div>
        <div class="col-4">
            <label class="form-label">Set Number</label>
            <input onblur="runSearch()" class="form-control" id="searchNum" />
        </div>
        <div class="col-4">
            <label class="form-label">Language</label>
            <input onblur="runSearch()" class="form-control" id="searchLan" />
        </div>
    </div>
    <div class="row" id="bulkSearch">
        <input class="form-control collapse" id="toggleType" value="database" />
        <div class="col-4">
            <label class="form-label">Bulk Search</label>
            <p class="small">Use the SET:NUM format. Please separate cards with a new line.</p>
            <textarea onblur="parseBulkSearch()" class="form-control" id="bulkEntry"></textarea>
        </div>        
    </div>
</div>