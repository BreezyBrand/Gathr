@model List<CardView>
@inject IConfiguration config;

@{
    string thisID;
    bool showArt = config.GetSection("ShowArt").Get<bool>();
    bool inInv;
    string invClass;
}
@*Locations*@        
<div class="container-fluid">
    <table class="table table-sm" id="InvTable">
        <thead class="bg-dark text-white text-center">
            <tr>
                <th>
                    Image
                </th>
                <th class="sortHeader" onclick="SortTable('Name')">
                    Name
                    <span id="sortName"></span>
                </th>
                <th class="sortHeader" onclick="SortTable('Set')">
                    Set
                    <span id="sortSet"></span>
                </th>
                <th class="sortHeader" onclick="SortTable('CN')">
                    CN
                    <span id="sortCN"></span>
                </th>
                <th class="sortHeader" onclick="SortTable('Mark')">
                    Mark
                    <span id="sortMark"></span>
                </th>
                <th class="sortHeader" onclick="SortTable('Lang')">
                    Language
                    <span id="sortLang"></span>
                </th>
                <th class="sortHeader" onclick="SortTable('Loc')">
                    Location
                    <span id="sortLoc"></span>
                </th>
                <th class="sortHeader" onclick="SortTable('Confirmed')">
                    Confirmed
                    <span id="sortConfirmed"></span>
                </th>
                <th class="sortHeader" onclick="SortTable('Colors')">
                    Colors
                    <span id="sortColors"></span>
                </th>
                <th class="sortHeader" onclick="SortTable('Type')">
                    Types
                    <span id="sortType"></span>
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var card in Model.Where(x => x.in_inventory).OrderBy(n => n.set).ThenBy(n => n.SortOrder))
            {
                @if (card.in_inventory)
                {
                    @foreach (var inv in card.inventory)
                    {
                        string mark_id = inv.Id + "_mark";
                        string loc_id = inv.Id + "_loc";
                        string conf_id = inv.Id + "_conf";
                        string row_id = inv.Id + "_row";
                        string lan_id = inv.Id + "_lan";
                        
                        <tr>
                            <td class="text-center">
                                @if (card.hasArt && showArt)
                                {
                                    <img title="@card.name (@card.set.ToUpper():@card.collector_number)" height="50" src="@card.art.png" />
                                }
                                else
                                {
                                    <img title="@card.name (@card.set.ToUpper():@card.collector_number)" height="50" src="~/imgback.jpg" />
                                }
                            </td>
                            <td>@Html.Raw(card.DisplayNameHTML())</td>
                            <td>@card.set.ToUpper()</td>
                            <td>@card.collector_number</td>
                            <td class="text-center">
                                <input id="@mark_id" value="@inv.Mark" class="w-25"/>                                
                            </td>
                            <td class="text-center">
                                <input id="@lan_id" value="@inv.Language" class="w-25" />
                            </td>
                            <td>
                                <input id="@loc_id" value="@inv.Location" class="w-100" />
                            </td>
                            <td class="text-center">
                                <input type="checkbox" id="@conf_id" value="@inv._confirmed" />
                            </td>
                            <td>
                                @foreach (var color in card.colors)
                                {
                                    <span class="d-inline-block">@color</span>
                                }
                            </td>
                            <td>@card.type_line</td>
                            <td style="min-width:150px">
                                <button class="btn btn-success" onclick="UpdateInventory(@inv.Id,'@inv.Card_Id.ToString()')">
                                    <i class="bi bi-floppy"></i>
                                </button>
                                <button class="btn btn-warning" onclick="CloneInventory(@inv.Id,'@inv.Card_Id.ToString()')">
                                    <i class="bi bi-clipboard-plus"></i>
                                </button>
                                <button class="btn btn-danger" onclick="DeleteInventory(@inv.Id,'@inv.Card_Id.ToString()')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center">
                            @if (card.hasArt && showArt)
                            {
                                <img title="@card.name (@card.set.ToUpper():@card.collector_number)" height="50" src="@card.art.png" />
                            }
                            else
                            {
                                <img title="@card.name (@card.set.ToUpper():@card.collector_number)" height="50" src="~/imgback.jpg" />
                            }
                        </td>
                        <td>@card.name</td>
                        <td>@card.set</td>
                        <td>@card.collector_number</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td>@card.type_line</td>
                        <td>
                            Add
                        </td>
                    </tr>
                }
            }
            <tr></tr>
        </tbody>
    </table>
</div>