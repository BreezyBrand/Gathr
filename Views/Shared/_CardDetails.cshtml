@model List<CardView>
@inject IConfiguration config;

@{
    string thisID;
    bool showArt = config.GetSection("ShowArt").Get<bool>();
    bool inInv;
    string invClass;    
}
@*Details*@
@if (Model.Any())
{
    <div class="container-fluid">
        <div class="row">
            @foreach (var card in Model)
            {
                <partial name="_CardDetailsCard" model="card"/>
            }
        </div>
    </div>
}
<div class="container-fluid">
    <div class="row">
        <div class="col-12 text-center">
            <button onclick="runMiniSearch()">Load More</button>
        </div>
    </div>
</div>
